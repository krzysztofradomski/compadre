{
  "name": "compadre",
  "version": "4.0.0",
  "description": "a name generator for javascript apps",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "dictionaries/"
  ],
  "scripts": {
    "test": "nyc mocha index.test.js",
    "demo": "node demo.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krzysztofradomski/compadre"
  },
  "keywords": [
    "random",
    "name",
    "generator"
  ],
  "bugs": {
    "url": "https://github.com/krzysztofradomski/compadre/issues"
  },
  "homepage": "https://github.com/krzysztofradomski/compadre",
  "author": "Krzysztof Radomski <krzysztof@radomski.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "mocha": "^11.0.0",
    "nyc": "^17.0.0"
  },
  "nyc": {
    "exclude": [
      "*.test.js",
      "demo.js"
    ]
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  }
}
